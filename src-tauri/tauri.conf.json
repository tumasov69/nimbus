{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nimbus",
  "version": "0.5.1",
  "identifier": "com.qqqex.nimbus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nimbus",
        "label": "main",
        "width": 1320,
        "height": 850,
        "minWidth": 1040,
        "minHeight": 700,
        "center": true,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.modrinth.com; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPLOCALDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/tumasov69/nimbus/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0NTNGQzkzQURDNEFENTQKUldSVXJjU3RrL3hUMU93VVFuTW5kNGw3dWh3alFpRlFDeG1iVy82VHBKNkNQdFZQTHFvdXFGRUUK"
    }
  }
}
